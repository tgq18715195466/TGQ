# Copy to .env; never commit real passwords or API keys.
POSTGRES_DSN=postgresql+psycopg://zhanggui_app:CHANGE_ME@127.0.0.1:5432/zhanggui_dev
POSTGRES_POOL_SIZE=10
POSTGRES_EXPECTED_DATABASE=zhanggui_dev
POSTGRES_EXPECTED_USER=zhanggui_app
CHECKPOINT_DSN=
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=zhanggui
JWT_AUDIENCE=zhanggui-api
ENVIRONMENT=production
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_RATE_LIMIT_ENABLED=false
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=knowledge
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
MINERU_BASE_URL=http://127.0.0.1:8001
MINERU_TIMEOUT_SECONDS=600
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=tei
RERANKER_BASE_URL=http://127.0.0.1:8003
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
WEB_SEARCH_ENABLED=false
MCP_SEARCH_URL=
MCP_SEARCH_TOKEN=
HYDE_ENABLED=false
MAX_FILE_SIZE_MB=50
MAX_DOCUMENT_PAGES=500
SCANNER_URL=
DEVELOPMENT_SKIP_SCANNER=false
# Compose only; values must be independently generated.
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
TENANT_ID=00000000-0000-0000-0000-000000000000
