# The application ERP backend and the evaluator must point to this same dedicated database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=motorparts_eval

EVAL_MYSQL_HOST=127.0.0.1
EVAL_MYSQL_PORT=3306
EVAL_MYSQL_USER=root
EVAL_MYSQL_PASSWORD=
EVAL_MYSQL_DB=motorparts_eval
EVAL_BASE_URL=http://127.0.0.1:8090

# Recommended additions to application config:
EVAL_MODE=true
DISABLE_WEB_SEARCH=true
DISABLE_CHART_MCP=true
