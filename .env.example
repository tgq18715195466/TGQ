# ============================================================
# ERP_OPENCLAW 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值
#   cp .env.example .env
# 由 src/agent/env_utils.py 的 load_dotenv(override=True) 读取
# ============================================================

# ---------- 大模型 API（真正生效的，config.py 会用到） ----------
# 外部模型 API（仍需联网）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-chat
SUMMARY_MODEL=deepseek-chat
MAIN_MODEL_TEMPERATURE=0.3

# ---------- 其他模型供应商（env_utils 已声明，但当前 config.py 未使用） ----------
# 仅当扩展模型时才需要，可按需删除
OPENAI_API_KEY=
OPENAI_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=
K2_API_KEY=
K2_BASE_URL=
LOCAL_BASE_URL=

# ---------- 沙箱（Daytona 备用，当前未使用） ----------
DAYTONA_API_KEY=
DAYTONA_BASE_URL=

POSTGRES_URI=postgresql://postgres:password@127.0.0.1:5432/erp_agent
LANGGRAPH_STRICT_MSGPACK=true
ERP_API_BASE_URL=http://127.0.0.1:8080/api
ERP_MCP_URL=http://127.0.0.1:8001/mcp
CHART_MCP_URL=
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp

# Required for a complete local run
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=motorparts_db
POSTGRES_REQUIRED=true
DISABLE_WEB_SEARCH=true
DISABLE_CHART_MCP=true
AUTH_COOKIE_SECURE=false
# AUTH_ALLOWED_ORIGINS=https://your-erp.example
