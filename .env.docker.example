# Copy to .env.docker and fill blank values. No local .env is loaded by containers.
# Use single quotes around values containing $ or # in this Compose env file.
COMPOSE_PROJECT_NAME=erp-openclaw-docker
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3001
MYSQL_DB=motorparts_db
MYSQL_USER=erp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
POSTGRES_DB=erp_agent
POSTGRES_USER=erp_agent
POSTGRES_PASSWORD=
# Model configuration is required by app startup. Health checks never invoke a model.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MAIN_MODEL=deepseek-chat
SUMMARY_MODEL=deepseek-chat

# Compose web service credentials. Provision this role in PostgreSQL first.
# For local demo only, these may match POSTGRES_USER/POSTGRES_PASSWORD.
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
